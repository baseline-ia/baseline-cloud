# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
POSTGRES_USER=your_local_postgres_user
POSTGRES_PASSWORD=your_local_postgres_password
POSTGRES_DB=your_local_database
# For npm run dev, use localhost. The Compose cloud service defaults to the internal host "postgres".
DATABASE_URL=postgres://your_local_postgres_user:your_local_postgres_password@localhost:5432/your_local_database

# Auth — CHANGE THESE IN PRODUCTION
# Must be at least 32 characters each
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars-long
TOKEN_PEPPER=change-me-to-another-secure-random-string-at-least-32-chars

# CORS — comma-separated list of allowed origins (CLI sends with no origin; leave empty for default)
ALLOWED_ORIGINS=

# Bootstrap — first user becomes admin automatically (set to true only for the very first signup)
BOOTSTRAP_ADMIN=true
