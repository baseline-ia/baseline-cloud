<div class="page-header">
  <h1><%= it.t('page.skills.title') %></h1>
  <p class="subtitle"><%= it.t('page.skills.subtitle') %></p>
</div>

<% if (it.adoption.length === 0) { %>
  <div class="empty-state">
    <div class="icon">🧩</div>
    <p><strong><%= it.t('page.skills.no_skills') %></strong></p>
    <p><%= it.t('page.skills.no_skills_help') %></p>
  </div>
<% } else { %>

  <% if (it.byTool.length > 0) { %>
  <article class="panel">
    <div class="panel-header">
      <h2 class="panel-title"><%= it.t('chart.skills_by_tool') %></h2>
      <p class="panel-subtitle"><%= it.t('chart.skills_by_tool_sub') %></p>
    </div>
    <div class="chart-wrap chart-wrap-sm">
      <canvas id="skillsByTool" data-chart='<%~ JSON.stringify({ type: "doughnut", data: { labels: it.byTool.map(t => t.tool), datasets: [{ data: it.byTool.map(t => t.c), backgroundColor: ["#4f46e5", "#10b981", "#f59e0b", "#f43f5e", "#3b82f6", "#8b5cf6"], borderWidth: 0 }] }, options: { cutout: "65%", plugins: { legend: { position: "right" } } } }) %>'></canvas>
    </div>
  </article>
  <% } %>

  <article class="panel">
    <div class="panel-header">
      <h2 class="panel-title"><%= it.t('chart.all_skills') %></h2>
    </div>
    <table>
      <thead>
        <tr>
          <th>Skill</th>
          <th>Tool</th>
          <th class="text-right">Adopters</th>
          <th>Last installed</th>
        </tr>
      </thead>
      <tbody>
        <% it.adoption.forEach(function(row) { %>
          <tr>
            <td><code style="color: var(--primary); font-weight: 500;"><%= row.skillName %></code></td>
            <td><span class="event-type"><%= row.tool %></span></td>
            <td class="text-right">
              <span class="badge <%= row.adopters > 1 ? 'badge-closed' : 'badge-open' %>">
                <%= row.adopters %> <%= row.adopters === 1 ? 'dev' : 'devs' %>
              </span>
            </td>
            <td class="text-muted" style="font-size: 0.875rem;">
              <%= row.lastInstalledAt ? new Date(row.lastInstalledAt).toLocaleString() : '—' %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </article>
<% } %>
