<div class="page-header">
  <div class="flex-between">
    <div>
      <h1><code style="font-size: 1.5rem; color: var(--text);"><%= it.username %></code></h1>
      <p class="subtitle">
        <a href="/dashboard/developers" style="color: var(--text-muted); text-decoration: none;"><%= it.t('nav.back_to') %> developers</a>
      </p>
    </div>
    <% if (it.detail.lastSeenAt) { %>
      <span class="text-muted">Last seen <%= new Date(it.detail.lastSeenAt).toLocaleString() %></span>
    <% } %>
  </div>
</div>

<div class="stat-grid">
  <article class="stat-card">
    <p class="stat-value"><%= it.detail.recent.length %></p>
    <p class="stat-label"><%= it.t('page.developer_detail.stats_50') %></p>
  </article>
  <article class="stat-card">
    <p class="stat-value"><%= it.detail.byType.length %></p>
    <p class="stat-label"><%= it.t('page.developer_detail.unique_types') %></p>
  </article>
  <article class="stat-card">
    <p class="stat-value"><%= it.detail.byProject.length %></p>
    <p class="stat-label"><%= it.t('page.developer_detail.projects_touched') %></p>
  </article>
</div>

<div class="panel-grid-2">
  <article class="panel">
    <div class="panel-header"><h2 class="panel-title">By event type</h2></div>
    <% if (it.detail.byType.length === 0) { %>
      <div class="empty-state"><p>No events.</p></div>
    <% } else { %>
      <table>
        <thead><tr><th>Event</th><th class="text-right">Count</th></tr></thead>
        <tbody>
          <% it.detail.byType.forEach(function(t) { %>
            <tr>
              <td><span class="event-type"><%= t.eventType %></span></td>
              <td class="text-right"><%= t.c %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </article>

  <article class="panel">
    <div class="panel-header"><h2 class="panel-title">By project</h2></div>
    <% if (it.detail.byProject.length === 0) { %>
      <div class="empty-state"><p>No projects.</p></div>
    <% } else { %>
      <table>
        <thead><tr><th>Project</th><th class="text-right">Count</th></tr></thead>
        <tbody>
          <% it.detail.byProject.forEach(function(p) { %>
            <tr>
              <td><code><%= p.project %></code></td>
              <td class="text-right"><%= p.c %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </article>
</div>

<article class="panel">
  <div class="panel-header"><h2 class="panel-title"><%= it.t('page.developer_detail.recent_events') %></h2></div>
  <%~ include('../partials/activity-feed', { recent: it.detail.recent }) %>
</article>
