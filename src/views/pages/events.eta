<div class="page-header">
  <h1><%= it.t('page.events.title') %></h1>
  <p class="subtitle"><%= it.t('page.events.subtitle') %></p>
<% if (it.events.length === 0) { %>
  <div class="empty-state"><div class="icon">📋</div><p><%= it.t('empty.no_events') %></p></div>
<% } else { %>
  <table>
    <thead>
      <tr><th>When</th><th>User</th><th>Event</th><th>Project</th><th>Payload</th></tr>
    </thead>
    <tbody>
      <% it.events.forEach(function(e) { %>
        <tr>
          <td class="text-muted text-mono" style="font-size: 0.8125rem; white-space: nowrap;">
            <%= e.occurredAt instanceof Date ? e.occurredAt.toLocaleString() : new Date(e.occurredAt).toLocaleString() %>
          </td>
          <td><code><%= e.username %></code></td>
          <td><span class="event-type"><%= e.eventType %></span></td>
          <td><code><%= e.project %></code></td>
          <td><code style="font-size: 0.75rem; color: var(--text-muted);"><%= JSON.stringify(e.payload).slice(0, 100) %></code></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>
