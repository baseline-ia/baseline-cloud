<div class="page-header">
  <h1><%= it.t('page.admin_settings.title') %></h1>
  <p class="subtitle"><%= it.t('page.admin_settings.subtitle') %></p>
</div>

<article class="panel">
  <div class="panel-header">
    <div>
      <h2 class="panel-title"><%= it.t('page.admin_settings.time_baselines') %></h2>
      <p class="panel-subtitle"><%= it.t('page.admin_settings.time_baselines_sub') %></p>
    </div>
  </div>

  <div class="panel-subtitle" style="margin-bottom: 1rem; padding: 0.75rem 1rem; background: var(--info-soft); border-left: 3px solid var(--info); border-radius: var(--radius-sm); color: var(--text); font-size: 0.875rem;">
    <strong>ℹ️ <%= it.t('page.admin_settings.info') %>:</strong> <%= it.t('page.admin_settings.info_body') %>
  </div>

  <form method="post" action="/dashboard/admin/settings/time-baselines">
    <table>
      <thead>
        <tr>
          <th>Work type</th>
          <th class="text-right"><%= it.t('stat.time_this_week') %> (minutes)</th>
          <th class="text-right"><%= it.t('common.hours') %></th>
        </tr>
      </thead>
      <tbody>
        <% Object.entries(it.baselines).forEach(function(entry) { %>
          <% const [workType, minutes] = entry; %>
          <tr>
            <td><span class="event-type"><%= workType %></span></td>
            <td>
              <input type="number" name="baselines[<%= workType %>]" value="<%= minutes %>" min="1" step="15" style="max-width: 120px; text-align: right; margin: 0;" />
            </td>
            <td class="text-right text-muted"><%= Math.round(minutes / 60 * 10) / 10 %><%= it.t('common.hours') %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <div style="margin-top: 1rem; display: flex; gap: 0.5rem;">
      <button type="submit"><%= it.t('page.admin_settings.save') %></button>
      <button type="reset" class="secondary"><%= it.t('page.admin_settings.reset') %></button>
    </div>
  </form>
</article>
