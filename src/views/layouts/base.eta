<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= it.title ?? 'baseline-cloud' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <style>
    /* ============================================================
       baseline-cloud design system
       Tokens, layout, components. Pico is the base; this overrides
       its look with a more dashboard-oriented aesthetic.
       ============================================================ */
    :root {
      /* Color tokens (HSL-friendly, light mode) */
      --bg: #f7f8fb;
      --bg-elevated: #ffffff;
      --bg-subtle: #f1f3f9;
      --border: #e5e7eb;
      --border-strong: #d1d5db;
      --text: #0f172a;
      --text-muted: #64748b;
      --text-faint: #94a3b8;

      --primary: #4f46e5;        /* indigo-600 */
      --primary-hover: #4338ca;  /* indigo-700 */
      --primary-soft: #eef2ff;   /* indigo-50 */

      --success: #10b981;        /* emerald-500 */
      --success-soft: #ecfdf5;
      --warning: #f59e0b;        /* amber-500 */
      --warning-soft: #fffbeb;
      --danger: #f43f5e;         /* rose-500 */
      --danger-soft: #fff1f2;
      --info: #3b82f6;           /* blue-500 */
      --info-soft: #eff6ff;

      --chart-1: #4f46e5;
      --chart-2: #10b981;
      --chart-3: #f59e0b;
      --chart-4: #f43f5e;
      --chart-5: #3b82f6;
      --chart-6: #8b5cf6;
      --chart-7: #ec4899;
      --chart-8: #14b8a6;

      --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06);
      --shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 12px 32px rgba(15, 23, 42, 0.10);
      --radius: 12px;
      --radius-sm: 8px;
      --radius-lg: 16px;
    }

    [data-theme="dark"] {
      --bg: #0b1020;
      --bg-elevated: #131a30;
      --bg-subtle: #1a2240;
      --border: #2a3358;
      --border-strong: #3a4570;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --text-faint: #64748b;
      --primary-soft: #312e81;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html, body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    body { background: var(--bg); color: var(--text); margin: 0; font-size: 15px; line-height: 1.5; -webkit-font-smoothing: antialiased; }

    code, pre, .mono { font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace; }

    main { max-width: 1400px; margin: 0 auto; padding: 1.5rem; }

    /* ===================== Navbar ===================== */
    .navbar {
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 1.5rem;
      display: flex; justify-content: space-between; align-items: center;
      position: sticky; top: 0; z-index: 100;
      box-shadow: var(--shadow-sm);
    }
    .navbar-brand { display: flex; align-items: center; gap: 0.625rem; font-weight: 700; font-size: 1.0625rem; color: var(--text); text-decoration: none; }
    .navbar-brand .logo {
      width: 32px; height: 32px; border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--primary), #8b5cf6);
      display: flex; align-items: center; justify-content: center;
      color: white; font-weight: 800; font-size: 0.875rem;
      box-shadow: 0 2px 8px rgba(79, 70, 229, 0.3);
    }
    .navbar-links { display: flex; gap: 0.25rem; flex-wrap: wrap; justify-content: flex-end; }
    .navbar-links a {
      color: var(--text-muted); text-decoration: none;
      padding: 0.5rem 0.75rem; border-radius: var(--radius-sm);
      font-size: 0.875rem; font-weight: 500;
      white-space: nowrap;
      transition: all 0.15s ease;
    }
    .navbar-links a:hover { background: var(--bg-subtle); color: var(--text); }
    .navbar-links a.active { background: var(--primary-soft); color: var(--primary); }
    @media (max-width: 1100px) {
      .navbar-links a { padding: 0.5rem 0.625rem; font-size: 0.8125rem; }
    }
    @media (max-width: 900px) {
      .navbar-links a { padding: 0.4375rem 0.5rem; font-size: 0.75rem; }
    }
    .navbar-user { display: flex; align-items: center; gap: 0.75rem; }
    .navbar-user .avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), #8b5cf6);
      color: white; display: flex; align-items: center; justify-content: center;
      font-weight: 600; font-size: 0.8125rem;
    }
    .navbar-user .username { font-size: 0.875rem; color: var(--text-muted); font-weight: 500; }
    .navbar-user form { display: inline; margin: 0; }
    .btn-logout {
      background: transparent; color: var(--text-muted); border: 1px solid var(--border);
      padding: 0.375rem 0.75rem; border-radius: var(--radius-sm);
      font-size: 0.8125rem; font-weight: 500; cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-logout:hover { background: var(--danger-soft); color: var(--danger); border-color: var(--danger); }

    /* ===================== Page header ===================== */
    .page-header { margin-bottom: 1.5rem; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; margin: 0 0 0.25rem; letter-spacing: -0.02em; }
    .page-header .subtitle { color: var(--text-muted); font-size: 0.9375rem; margin: 0; }

    /* ===================== Stat cards ===================== */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr); /* 4x1 desktop */
      gap: 1rem;
      margin: 1.5rem 0;
    }
    @media (max-width: 1100px) {
      .stat-grid { grid-template-columns: repeat(2, 1fr); } /* 2x1 tablet */
    }
    @media (max-width: 540px) {
      .stat-grid { grid-template-columns: 1fr; } /* 1x1 mobile */
    }
    .stat-card {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
      position: relative; overflow: hidden;
      transition: all 0.2s ease;
    }
    .stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--border-strong); }
    .stat-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: var(--primary);
    }
    .stat-card.accent-success::before { background: var(--success); }
    .stat-card.accent-warning::before { background: var(--warning); }
    .stat-card.accent-info::before { background: var(--info); }
    .stat-card.accent-danger::before { background: var(--danger); }
    .stat-value { font-size: 2rem; font-weight: 700; color: var(--text); margin: 0; letter-spacing: -0.03em; line-height: 1.1; }
    .stat-value .unit { font-size: 0.875rem; font-weight: 500; color: var(--text-muted); margin-left: 0.25rem; }
    .stat-label { font-size: 0.8125rem; color: var(--text-muted); margin: 0.5rem 0 0; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; }
    .stat-trend { display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.75rem; font-weight: 600; margin-top: 0.5rem; padding: 0.125rem 0.5rem; border-radius: 999px; }
    .stat-trend.up { background: var(--success-soft); color: var(--success); }
    .stat-trend.down { background: var(--danger-soft); color: var(--danger); }

    /* ===================== Section / panels ===================== */
    .panel {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-sm);
    }
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .panel-title { font-size: 1.0625rem; font-weight: 600; margin: 0; }
    .panel-subtitle { font-size: 0.875rem; color: var(--text-muted); margin: 0.25rem 0 0; }
    .panel-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem; }
    .panel-grid-2 { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
    @media (max-width: 900px) { .panel-grid-2 { grid-template-columns: 1fr; } }

    .section-title {
      font-size: 0.8125rem; font-weight: 600; color: var(--text-muted);
      text-transform: uppercase; letter-spacing: 0.05em;
      margin: 2rem 0 0.75rem;
    }

    /* ===================== Tables ===================== */
    table { width: 100%; border-collapse: separate; border-spacing: 0; }
    table thead th {
      text-align: left; padding: 0.625rem 0.75rem;
      font-size: 0.75rem; font-weight: 600;
      color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;
      border-bottom: 1px solid var(--border);
    }
    table tbody td {
      padding: 0.75rem; border-top: 1px solid var(--border);
      font-size: 0.9375rem; vertical-align: middle;
    }
    table tbody tr:hover { background: var(--bg-subtle); }
    table tbody tr:first-child td { border-top: none; }

    .event-type {
      display: inline-block; padding: 0.1875rem 0.5rem;
      border-radius: var(--radius-sm);
      background: var(--primary-soft); color: var(--primary);
      font-family: 'JetBrains Mono', monospace; font-size: 0.8125rem; font-weight: 500;
    }
    .badge {
      display: inline-flex; align-items: center; gap: 0.25rem;
      padding: 0.1875rem 0.5rem; border-radius: 999px;
      font-size: 0.75rem; font-weight: 600;
    }
    .badge-open { background: var(--info-soft); color: var(--info); }
    .badge-closed { background: var(--success-soft); color: var(--success); }
    .badge-admin { background: var(--primary-soft); color: var(--primary); }
    .badge-member { background: var(--bg-subtle); color: var(--text-muted); }
    .badge-revoked { background: var(--danger-soft); color: var(--danger); }
    .badge-source { background: var(--info-soft); color: var(--info); }
    .badge-source-default { background: var(--bg-subtle); color: var(--text-muted); }

    code { font-size: 0.875em; color: var(--text); }

    .positive { color: var(--success); font-weight: 600; }
    .negative { color: var(--danger); font-weight: 600; }
    .neutral { color: var(--text-muted); }

    /* ===================== Login page ===================== */
    .login-wrap {
      min-height: calc(100vh - 200px); display: flex; align-items: center; justify-content: center;
      padding: 2rem 1rem;
    }
    .login-card {
      max-width: 420px; width: 100%;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 2.5rem;
      box-shadow: var(--shadow-lg);
    }
    .login-card .brand-logo {
      width: 56px; height: 56px; border-radius: 16px;
      background: linear-gradient(135deg, var(--primary), #8b5cf6);
      display: flex; align-items: center; justify-content: center;
      color: white; font-weight: 800; font-size: 1.5rem; margin: 0 auto 1rem;
      box-shadow: 0 8px 24px rgba(79, 70, 229, 0.4);
    }
    .login-card h1 { text-align: center; font-size: 1.5rem; margin: 0 0 0.25rem; }
    .login-card .subtitle { text-align: center; color: var(--text-muted); font-size: 0.9375rem; margin: 0 0 1.5rem; }
    .login-card form label { font-size: 0.875rem; font-weight: 500; color: var(--text); }
    .login-card input { font-size: 0.9375rem; }
    .login-card button[type="submit"] {
      width: 100%; padding: 0.75rem; font-weight: 600; font-size: 0.9375rem;
      background: linear-gradient(135deg, var(--primary), #8b5cf6);
      border: none; color: white;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }
    .login-card button[type="submit"]:hover { background: var(--primary-hover); }
    .login-card .error-msg {
      background: var(--danger-soft); color: var(--danger);
      padding: 0.625rem 0.875rem; border-radius: var(--radius-sm);
      font-size: 0.875rem; margin-bottom: 1rem;
    }
    .login-card .help-text { font-size: 0.8125rem; color: var(--text-muted); margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
    .login-card .help-text code { font-size: 0.75rem; background: var(--bg-subtle); padding: 0.125rem 0.375rem; border-radius: 4px; }

    /* ===================== Forms ===================== */
    form input, form select, form textarea {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.5rem 0.75rem;
      font-size: 0.9375rem;
      width: 100%;
      margin-top: 0.25rem;
      color: var(--text);
    }
    form input:focus, form select:focus { border-color: var(--primary); outline: 2px solid var(--primary-soft); outline-offset: 0; }
    form label { font-size: 0.875rem; font-weight: 500; color: var(--text); display: block; margin-bottom: 0.75rem; }
    form button[type="submit"] {
      background: var(--primary); color: white; border: none;
      padding: 0.625rem 1.25rem; border-radius: var(--radius-sm);
      font-weight: 600; font-size: 0.9375rem; cursor: pointer;
      transition: all 0.15s ease;
    }
    form button[type="submit"]:hover { background: var(--primary-hover); }
    form button.secondary {
      background: var(--bg-elevated); color: var(--text); border: 1px solid var(--border);
    }
    form button.secondary:hover { background: var(--bg-subtle); }
    form button.danger { background: var(--danger); }
    form button.danger:hover { background: #e11d48; }

    /* ===================== Empty state ===================== */
    .empty-state {
      text-align: center; padding: 3rem 1.5rem;
      color: var(--text-muted);
    }
    .empty-state .icon { font-size: 2.5rem; margin-bottom: 0.75rem; opacity: 0.5; }
    .empty-state p { margin: 0; font-size: 0.9375rem; }
    .empty-state code { font-size: 0.8125rem; background: var(--bg-subtle); padding: 0.125rem 0.375rem; border-radius: 4px; }

    /* ===================== Chart containers ===================== */
    .chart-wrap { position: relative; height: 280px; width: 100%; }
    .chart-wrap-sm { height: 200px; }
    .chart-wrap-lg { height: 320px; }

    /* ===================== Theme toggle ===================== */
    .theme-toggle {
      background: transparent; border: 1px solid var(--border);
      color: var(--text-muted); cursor: pointer; padding: 0.375rem 0.5rem;
      border-radius: var(--radius-sm); font-size: 0.875rem;
      display: flex; align-items: center; justify-content: center;
      width: 32px; height: 32px;
    }
    .theme-toggle:hover { background: var(--bg-subtle); color: var(--text); }

    /* ===================== Progress bar ===================== */
    .progress { width: 100%; height: 8px; background: var(--bg-subtle); border-radius: 4px; overflow: hidden; margin-top: 0.5rem; }
    .progress-bar { height: 100%; background: linear-gradient(90deg, var(--primary), #8b5cf6); border-radius: 4px; transition: width 0.3s ease; }
    .progress-bar.success { background: linear-gradient(90deg, var(--success), #34d399); }

    /* ===================== Utilities ===================== */
    .text-muted { color: var(--text-muted); }
    .text-success { color: var(--success); font-weight: 600; }
    .text-danger { color: var(--danger); }
    .text-mono { font-family: 'JetBrains Mono', monospace; font-size: 0.875em; }
    .flex { display: flex; }
    .flex-between { display: flex; justify-content: space-between; align-items: center; }
    .gap-1 { gap: 0.5rem; }
    .mt-1 { margin-top: 0.5rem; }
    .mt-2 { margin-top: 1rem; }
    .mb-1 { margin-bottom: 0.5rem; }
    .text-right { text-align: right; }
    .empty { color: var(--text-faint); font-style: italic; }

    /* ===================== Timeline ===================== */
    .timeline { position: relative; padding-left: 1.5rem; }
    .timeline::before { content: ''; position: absolute; left: 0.5rem; top: 0.5rem; bottom: 0.5rem; width: 2px; background: var(--border); }
    .timeline-item { position: relative; padding: 0.75rem 0; }
    .timeline-item::before { content: ''; position: absolute; left: -1.5rem; top: 1.125rem; width: 0.75rem; height: 0.75rem; border-radius: 50%; background: var(--bg-elevated); border: 2px solid var(--border-strong); }
    .timeline-item.opened::before { background: var(--info); border-color: var(--info); }
    .timeline-item.closed::before { background: var(--success); border-color: var(--success); }
    .timeline-item.commit::before { background: var(--primary); border-color: var(--primary); width: 0.5rem; height: 0.5rem; left: -1.375rem; top: 1.25rem; }
    .timeline-item .time { font-size: 0.75rem; color: var(--text-muted); }
    .timeline-item .label { font-weight: 500; font-size: 0.9375rem; margin-top: 0.125rem; }
    .timeline-item .detail { font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.125rem; }

    /* ===================== Activity feed (compact: user + project only) ===================== */
    .activity-feed { list-style: none; margin: 0; padding: 0; max-height: 320px; overflow-y: auto; }
    .activity-feed .activity-row {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      border-radius: var(--radius-sm);
      transition: background 0.15s ease;
    }
    .activity-feed .activity-row:hover { background: var(--bg-subtle); }
    .activity-feed .activity-avatar {
      width: 24px; height: 24px; border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), #8b5cf6);
      color: white; display: inline-flex; align-items: center; justify-content: center;
      font-weight: 600; font-size: 0.6875rem;
      flex-shrink: 0;
    }
    .activity-feed .activity-username { font-size: 0.875rem; font-weight: 500; color: var(--text); }
    .activity-feed .activity-sep { color: var(--text-faint); font-size: 0.75rem; }
    .activity-feed .activity-project {
      font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;
      background: var(--bg-subtle); color: var(--text-muted);
      padding: 0.125rem 0.5rem; border-radius: 4px;
    }
  </style>
</head>
<body>
  <% if (it.user) { %>
  <nav class="navbar">
    <a href="/dashboard/" class="navbar-brand">
      <span class="logo">b</span>
      baseline-cloud
    </a>
    <div class="navbar-links">
      <a href="/dashboard/" class="<%= it.active === 'overview' ? 'active' : '' %>"><%= it.t('nav.overview') %></a>
      <a href="/dashboard/changes" class="<%= it.active === 'changes' ? 'active' : '' %>"><%= it.t('nav.changes') %></a>
      <a href="/dashboard/skills" class="<%= it.active === 'skills' ? 'active' : '' %>"><%= it.t('nav.skills') %></a>
      <a href="/dashboard/events" class="<%= it.active === 'events' ? 'active' : '' %>"><%= it.t('nav.events') %></a>
      <a href="/dashboard/developers" class="<%= it.active === 'developers' ? 'active' : '' %>"><%= it.t('nav.developers') %></a>
      <a href="/dashboard/activity" class="<%= it.active === 'activity' ? 'active' : '' %>"><%= it.t('nav.activity') %></a>
      <% if (it.user?.role === 'admin') { %>
        <a href="/dashboard/admin/tokens" class="<%= it.active === 'admin-tokens' ? 'active' : '' %>"><%= it.t('nav.tokens') %></a>
        <a href="/dashboard/admin/users" class="<%= it.active === 'admin-users' ? 'active' : '' %>"><%= it.t('nav.users') %></a>
        <a href="/dashboard/admin/settings" class="<%= it.active === 'admin-settings' ? 'active' : '' %>"><%= it.t('nav.settings') %></a>
      <% } %>
    </div>
    <div class="navbar-user">
      <div class="avatar"><%= (it.user?.username ?? '?').charAt(0).toUpperCase() %></div>
      <span class="username"><%= it.user?.username %></span>
      <% const otherLocale = (it.locale === 'es' ? 'en' : 'es'); const switchPath = '/dashboard/set-locale?locale=' + otherLocale + '&next=' + encodeURIComponent(it.currentPath ?? '/dashboard/'); %>
      <a class="theme-toggle" href="<%= switchPath %>" title="<%= it.t('language.' + otherLocale) %>" style="text-decoration: none; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em; padding: 0 0.5rem; width: auto; height: 32px;">
        <%= (it.locale ?? 'en').toUpperCase() %>
      </a>
      <button class="theme-toggle" id="themeToggle" title="Toggle theme">🌗</button>
      <form method="post" action="/dashboard/logout">
        <button type="submit" class="btn-logout"><%= it.t('nav.logout') %></button>
      </form>
    </div>
  </nav>
  <% } %>
  <main>
    <%~ it.body %>
  </main>
  <script>
    // Theme toggle (persists in localStorage)
    (function() {
      const saved = localStorage.getItem('baseline-cloud-theme') ?? 'light';
      document.documentElement.setAttribute('data-theme', saved);
      const btn = document.getElementById('themeToggle');
      if (btn) btn.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme') ?? 'light';
        const next = cur === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('baseline-cloud-theme', next);
        // Re-render charts so they pick up the new theme colors
        document.querySelectorAll('canvas[data-chart]').forEach((c) => {
          const inst = Chart.getChart(c);
          if (inst) inst.destroy();
        });
        initCharts();
      });

      // Active link highlighting (server sends `active`, this is a backup)
      const path = window.location.pathname;
      document.querySelectorAll('.navbar-links a').forEach(a => {
        if (a.getAttribute('href') === path) a.classList.add('active');
      });
    })();

    // Chart initialization — reads canvas[data-chart] and creates Chart.js instances
    function initCharts() {
      const cs = getComputedStyle(document.documentElement);
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const textColor = isDark ? '#cbd5e1' : '#64748b';
      const gridColor = isDark ? 'rgba(148, 163, 184, 0.1)' : 'rgba(100, 116, 139, 0.1)';

      Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
      Chart.defaults.color = textColor;
      Chart.defaults.borderColor = gridColor;

      document.querySelectorAll('canvas[data-chart]').forEach((canvas) => {
        if (Chart.getChart(canvas)) return;
        try {
          const config = JSON.parse(canvas.dataset.chart);
          if (config.options) {
            config.options = {
              responsive: true,
              maintainAspectRatio: false,
              ...config.options,
              plugins: {
                ...(config.options.plugins ?? {}),
                legend: { display: true, position: 'bottom', labels: { color: textColor, font: { size: 11 } }, ...(config.options.plugins?.legend ?? {}) },
              },
              scales: {
                ...(config.options.scales ?? {}),
                x: { ticks: { color: textColor, font: { size: 11 } }, grid: { color: gridColor, display: false }, ...(config.options.scales?.x ?? {}) },
                y: { ticks: { color: textColor, font: { size: 11 } }, grid: { color: gridColor }, beginAtZero: true, ...(config.options.scales?.y ?? {}) },
              },
            };
          }
          new Chart(canvas, config);
        } catch (e) {
          console.error('Failed to init chart', canvas.id, e);
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCharts);
    } else {
      initCharts();
    }
  </script>
</body>
</html>
