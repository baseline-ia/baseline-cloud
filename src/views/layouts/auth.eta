<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sign in · baseline-cloud</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    /* Same design system as base.eta — duplicated here for the login page */
    :root {
      --bg: #f7f8fb;
      --bg-elevated: #ffffff;
      --bg-subtle: #f1f3f9;
      --border: #e5e7eb;
      --border-strong: #d1d5db;
      --text: #0f172a;
      --text-muted: #64748b;
      --text-faint: #94a3b8;
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --primary-soft: #eef2ff;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #f43f5e;
      --danger-soft: #fff1f2;
      --radius: 12px;
      --radius-sm: 8px;
      --radius-lg: 16px;
      --shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 12px 32px rgba(15, 23, 42, 0.10);
    }
    [data-theme="dark"] {
      --bg: #0b1020;
      --bg-elevated: #131a30;
      --bg-subtle: #1a2240;
      --border: #2a3358;
      --border-strong: #3a4570;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --text-faint: #64748b;
      --primary-soft: #312e81;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    body { background: var(--bg); color: var(--text); margin: 0; font-size: 15px; line-height: 1.5; -webkit-font-smoothing: antialiased; min-height: 100vh; }
    code, pre, .mono { font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace; }

    /* Login page (matches login.eta classes) */
    .login-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }
    .login-card { max-width: 420px; width: 100%; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2.5rem; box-shadow: var(--shadow-lg); }
    .login-card .brand-logo { width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, var(--primary), #8b5cf6); display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; font-size: 1.5rem; margin: 0 auto 1rem; box-shadow: 0 8px 24px rgba(79, 70, 229, 0.4); }
    .login-card h1 { text-align: center; font-size: 1.5rem; margin: 0 0 0.25rem; }
    .login-card .subtitle { text-align: center; color: var(--text-muted); font-size: 0.9375rem; margin: 0 0 1.5rem; }
    .login-card form label { font-size: 0.875rem; font-weight: 500; color: var(--text); display: block; margin-bottom: 0.75rem; }
    .login-card form input { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.5rem 0.75rem; font-size: 0.9375rem; width: 100%; margin-top: 0.25rem; color: var(--text); }
    .login-card form input:focus { border-color: var(--primary); outline: 2px solid var(--primary-soft); outline-offset: 0; }
    .login-card button[type="submit"] { width: 100%; padding: 0.75rem; font-weight: 600; font-size: 0.9375rem; background: linear-gradient(135deg, var(--primary), #8b5cf6); border: none; color: white; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3); margin-top: 0.5rem; cursor: pointer; }
    .login-card button[type="submit"]:hover { background: var(--primary-hover); }
    .login-card .error-msg { background: var(--danger-soft); color: var(--danger); padding: 0.625rem 0.875rem; border-radius: var(--radius-sm); font-size: 0.875rem; margin-bottom: 1rem; }
    .login-card .help-text { font-size: 0.8125rem; color: var(--text-muted); margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
    .login-card .help-text code { font-size: 0.75rem; background: var(--bg-subtle); padding: 0.125rem 0.375rem; border-radius: 4px; }
  </style>
</head>
<body>
  <%~ it.body %>
</body>
</html>
